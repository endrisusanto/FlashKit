[Unit]
Description=FlashKit Host Helper Daemon for Remote Reopen
After=network.target

[Service]
Type=simple
User=endri-pro
Environment=DISPLAY=:0
WorkingDirectory=/home/endri-pro/dev/BOW
ExecStart=/usr/bin/python3 /home/endri-pro/dev/BOW/scripts/flashkit-host-daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
